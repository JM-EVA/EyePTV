<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EyePTV voor iPhone (.NET MAUI). Staat bewust NIET in IptvPlayer.sln: de Windows-bouw (desktop, tests, publish) blijft ongewijzigd.
    Bouwen kan alleen op een Mac (of op de GitHub macOS-runner, zie .github/workflows/ios.yml).
    Gekozen combinatie: .NET 8 SDK (band 8.0.1xx) + iOS-workload 18.0.8319 (Xcode 16.0, iOS 18.0 SDK) + LibVLCSharp 3.9.4 (laatste met net8.0-ios18.0).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>EyePTV.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>

    <!-- De workload levert MAUI 8.0.3 (bouwgereedschap); de eigenlijke bibliotheken komen uit NuGet in deze nieuwere 8.0-versie (LibVLCSharp.MAUI vraagt >= 8.0.70). -->
    <MauiVersion>8.0.100</MauiVersion>

    <ApplicationTitle>EyePTV</ApplicationTitle>
    <ApplicationId>com.eyeptv.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

    <!-- Dezelfde gedeelde Engine-code gebruikt reflectie-bindings: geen compiled bindings nodig. -->
    <MauiEnableXamlCBindingWithSourceCompilation>false</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#E5132D" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E0E10" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IptvPlayer.Engine\IptvPlayer.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vaste versies. LibVLCSharp.MAUI 3.9.4 is de laatste met net8.0-ios; nieuwere vragen .NET 9/10. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="LibVLCSharp.MAUI" Version="3.9.4" />
    <PackageReference Include="VideoLAN.LibVLC.iOS" Version="3.6.1" />
  </ItemGroup>

</Project>
