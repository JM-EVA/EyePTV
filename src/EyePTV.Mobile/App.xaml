<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EyePTV.Mobile.App">
    <Application.Resources>
        <Color x:Key="Bg">#0E0E10</Color>
        <Color x:Key="Surface">#1B1B20</Color>
        <Color x:Key="Surface2">#26262D</Color>
        <Color x:Key="Accent">#E5132D</Color>
        <Color x:Key="Dim">#9A9AA5</Color>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <Style x:Key="DimLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Surface2}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinimumHeightRequest" Value="46"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource Accent}"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinimumHeightRequest" Value="46"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="PlaceholderColor" Value="{StaticResource Dim}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
            <Setter Property="MinimumHeightRequest" Value="44"/>
        </Style>
        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="TitleColor" Value="{StaticResource Dim}"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Color" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
        </Style>
    </Application.Resources>
</Application>
