<UserControl x:Class="IptvPlayer.Desktop.Views.RecordingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:IptvPlayer.Desktop.Services">

    <UserControl.Resources>
        <svc:UrlToImageConverter x:Key="UrlToImage"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" Margin="0,0,0,14"/>

            <!-- Opnemen: instellingen -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                    Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Opnemen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,0,0,14"
                               Text="Neem een programma op via de Gids, of met de knop Opnemen bij een zender. Een opname loopt tot je stopt, tot een eindtijd, of zolang het programma in de EPG staat. De app moet openstaan om op te nemen. Veel providers staan maar 1 of 2 streams tegelijk toe; kijken en opnemen tegelijk kan dan mislukken."/>

                    <TextBlock Text="Opnames bewaren in" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RecordingFolder, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding FolderError}" Foreground="#E5A04B" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,4"
                               Visibility="{Binding HasFolderError, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Begin eerder (minuten)" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding MarginOptions}" SelectedItem="{Binding RecordBeforeMinutes, Mode=TwoWay}" MinWidth="110"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Loop langer door (minuten)" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding MarginOptions}" SelectedItem="{Binding RecordAfterMinutes, Mode=TwoWay}" MinWidth="110"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,8,0,0"
                               Text="Een opname van een programma begint dit aantal minuten vóór de start en eindigt dit aantal minuten na het einde, zodat je niets mist als de uitzending niet precies op tijd is."/>
                </StackPanel>
            </Border>

            <!-- Opnames beheren -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16"
                    Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Recordings}">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                        <TextBlock Text="Opnames" FontSize="16" FontWeight="SemiBold"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,4"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text="Je hebt nog niets opgenomen of ingepland. Open de Gids en kies bij een programma 'Opnemen'."/>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"
                                               Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}, IsAsync=True}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Style="{StaticResource DimText}">
                                                <Run Text="{Binding ChannelName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding WhenText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF6B64"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="#E5A04B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Afspelen" Style="{StaticResource AccentButton}" Padding="12,5" Margin="0,0,8,0"
                                                    Command="{Binding PlayCommand}"
                                                    Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{Binding StopText}" Padding="12,5" Margin="0,0,8,0" Command="{Binding StopCommand}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Verwijderen" Padding="12,5" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
