<UserControl x:Class="IptvPlayer.Desktop.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:IptvPlayer.Desktop.Services">

    <UserControl.Resources>
        <svc:UrlToImageConverter x:Key="UrlToImage"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="820" HorizontalAlignment="Left">

            <!-- Instellingen -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                    Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Downloaden" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,0,0,14"
                               Text="Download een film of aflevering via de downloadknop in de lijst bij Films en Series, en kijk hem daarna ook zonder internet. Een download komt zoals de provider hem aanbiedt op je schijf (meestal .mkv of .mp4). Er wordt één tegelijk gedownload; een onderbroken download gaat verder waar hij was. Veel providers staan maar 1 of 2 streams tegelijk toe, dus tijdens een download kan kijken of opnemen mislukken."/>

                    <TextBlock Text="Downloads bewaren in" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DownloadFolder, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DownloadFolderError}" Foreground="#E5A04B" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                               Visibility="{Binding HasDownloadFolderError, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Overzicht -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16"
                    Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Downloads}">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                        <TextBlock Text="Je downloads" FontSize="16" FontWeight="SemiBold"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,4"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text="Je hebt nog niets gedownload. Open Films of Series en gebruik de downloadknop bij een film of aflevering."/>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0" Width="36" Height="52" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"
                                               Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}, IsAsync=True}"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Style="{StaticResource DimText}"/>
                                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0"
                                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                                <Setter Property="Foreground" Value="#E5A04B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶ Afspelen" Style="{StaticResource AccentButton}" Padding="12,5" Margin="0,0,8,0"
                                                    Command="{Binding PlayCommand}"
                                                    Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Pauzeren" Padding="12,5" Margin="0,0,8,0" Command="{Binding PauseCommand}"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Hervatten" Padding="12,5" Margin="0,0,8,0" Command="{Binding ResumeCommand}"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="Verwijderen" Padding="12,5" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
