<UserControl x:Class="IptvPlayer.Desktop.Views.SourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="820" HorizontalAlignment="Left">

            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Alles bijwerken" Command="{Binding SyncAllCommand}"
                        Visibility="{Binding HasSources, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Bronnen" FontSize="18" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,16"
                       Text="Een bron is je IPTV-provider. Je kiest per bron welke zenders in je persoonlijke lijst komen. Bij een update zie je alleen wat nieuw is en bepaal jij wat erbij mag."/>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" Margin="0,0,0,10"/>

            <!-- Bestaande bronnen -->
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}"/>
                                    <TextBlock Text="{Binding InfoText}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding LastSyncText}" Style="{StaticResource DimText}" FontSize="12"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#E5A04B" FontSize="12"/>
                                    <TextBlock Text="{Binding InsecureNote}" Foreground="#E5A04B" FontSize="12" TextWrapping="Wrap"
                                               TextTrimming="None" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InsecureNote}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding PrimaryActionText}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.PrimaryActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasPending}" Value="False">
                                                        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Bijwerken" Margin="0,0,8,0"
                                            Command="{Binding DataContext.SyncOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Verwijderen"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bron toevoegen -->
            <TextBlock Text="Bron toevoegen" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,10"/>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="M3U-link" IsChecked="{Binding IsM3u}" GroupName="kind" Margin="0,0,20,0"/>
                        <RadioButton Content="Xtream Codes (server + inlog)" IsChecked="{Binding IsXtream}" GroupName="kind"/>
                    </StackPanel>

                    <TextBlock Text="Naam (optioneel)" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                    <StackPanel Visibility="{Binding IsM3u, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="M3U-link" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewM3uUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsXtream, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Server (bijv. http://server.example:8080) of de volledige get.php-link" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <TextBlock Text="Gebruikersnaam" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        <TextBlock Text="Wachtwoord" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" Margin="0,0,0,10"/>
                    </StackPanel>

                    <TextBlock Text="Eigen TV-gids (XMLTV-link, optioneel)" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewEpgUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <Button Content="Toevoegen en zenders ophalen" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left" Padding="20,9"
                            Command="{Binding AddSourceCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
