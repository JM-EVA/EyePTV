<UserControl x:Class="IptvPlayer.Desktop.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" Margin="0,0,0,14"/>

            <!-- Taal -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Taal" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <TextBlock Text="Voorkeurstaal voor ondertiteling" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SubtitleLanguages}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedSubtitleLanguage, Mode=TwoWay}"
                              HorizontalAlignment="Left" MinWidth="260" Margin="0,0,0,12"/>

                    <CheckBox Content="Ondertiteling in deze taal automatisch aanzetten als de film of serie die heeft"
                              IsChecked="{Binding AutoSubtitles}" Margin="0,0,0,16"/>

                    <TextBlock Text="Voorkeurstaal voor audio" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AudioLanguages}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedAudioLanguage, Mode=TwoWay}"
                              HorizontalAlignment="Left" MinWidth="260"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,8,0,0"
                               Text="Heeft een film meerdere audiosporen, dan kiest de app het spoor in deze taal. Je kunt tijdens het kijken altijd zelf een ander spoor kiezen."/>
                </StackPanel>
            </Border>

            <!-- Afspelen -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Reservezenders" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Seconden wachten op beeld voordat de app naar een reservezender schakelt" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FailoverSeconds, UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left"
                             AutomationProperties.Name="Seconden voor overschakelen"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,8,0,0"
                               Text="Een reservezender stel je in via rechtsklikken op een zender in Mijn zenders. Tussen 3 en 120 seconden."/>
                </StackPanel>
            </Border>

            <!-- Herinneringen -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Herinneringen" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Minuten voor het begin van een programma dat je een melding krijgt" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ReminderMinutes, UpdateSourceTrigger=LostFocus}" Width="80" HorizontalAlignment="Left"
                             AutomationProperties.Name="Minuten vooraf"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,8,0,0"
                               Text="Herinneringen zet je in de Gids. Ze werken alleen terwijl de app open is. De instelling geldt voor nieuwe herinneringen."/>
                </StackPanel>
            </Border>

            <!-- Erotiek en pincode -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Afgeschermde inhoud" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding AdultLockText}" Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None"
                               FontSize="12" Margin="0,0,0,12"/>

                    <!-- Vergrendeld: code invoeren -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsAdultLocked, Converter={StaticResource BoolToVis}}">
                        <PasswordBox x:Name="UnlockPin" MaxLength="4" Width="110" Margin="0,0,10,0"
                                     KeyDown="UnlockPin_KeyDown" AutomationProperties.Name="Code van 4 cijfers"/>
                        <Button Content="Ontgrendelen" Style="{StaticResource AccentButton}" Padding="16,8" Click="Unlock_Click"/>
                    </StackPanel>
                    <Button Content="Weer vergrendelen" Padding="16,8" HorizontalAlignment="Left" Click="Lock_Click"
                            Visibility="{Binding IsAdultUnlocked, Converter={StaticResource BoolToVis}}"/>

                    <!-- Code wijzigen -->
                    <TextBlock Text="Code wijzigen" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Huidige code" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="CurrentPin" MaxLength="4" Width="110"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Nieuwe code" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="NewPin" MaxLength="4" Width="110"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Herhaal" Style="{StaticResource DimText}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="RepeatPin" MaxLength="4" Width="110"/>
                        </StackPanel>
                        <Button Content="Wijzigen" Padding="16,8" VerticalAlignment="Bottom" Click="ChangePin_Click"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PinMessage}" Foreground="#E5A04B" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,8,0,0"
                               Text="Films, series, zenders en opnames uit groepen als 'Adults' of 'XXX' zijn verborgen zolang de app vergrendeld is. De app is bij elke start vergrendeld. Een nieuwe code bestaat uit 4 cijfers. Zonder eigen code is de code 0000; kies dus zelf een code."/>
                </StackPanel>
            </Border>

            <!-- Beginscherm -->
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="Beginscherm" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <CheckBox Content="Bij kanalen een beeld van de zender tonen" IsChecked="{Binding ChannelPreviews}"/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" Margin="0,8,0,0"
                               Text="De kaarten met kanalen tonen dan een momentopname van de uitzending in plaats van het logo. Daarvoor opent de app de kanalen een paar seconden, één voor één. Heeft je provider maar één verbinding, dan gebeurt dit alleen als er niets speelt of wordt opgenomen."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
