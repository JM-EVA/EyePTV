<UserControl x:Class="IptvPlayer.Desktop.Views.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:svc="clr-namespace:IptvPlayer.Desktop.Services"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <svc:UrlToImageConverter x:Key="UrlToImage"/>

        <!-- Keuzemenu van de knop "Opnemen" -->
        <ContextMenu x:Key="RecordMenu">
            <MenuItem Header="Dit programma opnemen (met marge)" Command="{Binding RecordCommand}" CommandParameter="programme"/>
            <Separator/>
            <MenuItem Header="30 minuten opnemen" Command="{Binding RecordCommand}" CommandParameter="30"/>
            <MenuItem Header="1 uur opnemen" Command="{Binding RecordCommand}" CommandParameter="60"/>
            <MenuItem Header="2 uur opnemen" Command="{Binding RecordCommand}" CommandParameter="120"/>
            <Separator/>
            <MenuItem Header="Opnemen tot ik stop" Command="{Binding RecordCommand}" CommandParameter="until-stopped"/>
        </ContextMenu>

        <!-- Tabbladen (Zenders / Films / Series, dagen in de gids, seizoenen): een rij knoppen naast elkaar -->
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Poster van een film of serie op het bladerscherm: titel over het beeld, glasrand, zachte zoom bij aanwijzen -->
        <DataTemplate x:Key="TitlePoster">
            <Button Command="{Binding PlayCommand}" Margin="6" Cursor="Hand" ToolTip="{Binding Name}" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Width="170" Height="255" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform x:Name="Sc"/></Grid.RenderTransform>
                            <Border x:Name="Mask" CornerRadius="14" Background="Black"/>
                            <Grid>
                                <Grid.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=Mask}"/>
                                </Grid.OpacityMask>
                                <Rectangle Fill="{StaticResource PopupBrush}"/>
                                <Path Width="44" Height="44" Stretch="Uniform" Stroke="{StaticResource DimBrush}" StrokeThickness="1.5" Opacity="0.6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconMovies}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeries}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconSeries}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Image Stretch="UniformToFill" Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}, ConverterParameter=320, IsAsync=True}"/>
                                <Border VerticalAlignment="Bottom" Padding="12,44,12,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#CC000000" Offset="0.55"/>
                                            <GradientStop Color="#F2000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontWeight="Bold" FontSize="17"
                                                   TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="Edge" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Edge" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Zijbalk: persoonlijke lijst -->
        <Border Grid.Column="0" Width="340" Background="{StaticResource PanelBrush}"
                Visibility="{Binding ShowChrome, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Zoeken, soort en groep (verborgen zolang je de afleveringen van een serie bekijkt) -->
                <StackPanel Grid.Row="0" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Zoek in je lijst"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding FavoritesOnly}"
                                      ToolTip="Alleen favorieten tonen"/>
                        <TextBlock Text="Alleen favorieten" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Style="{StaticResource DimText}"/>
                    </StackPanel>
                    <CheckBox Content="Nieuwste eerst" IsChecked="{Binding SortNewest}" Margin="0,0,0,6"
                              ToolTip="Meest recent toegevoegd bovenaan"
                              Visibility="{Binding CanSortNewest, Converter={StaticResource BoolToVis}}"/>

                    <!-- Live / Films / Series en de groepen staan in het menu links (MainWindow) -->
                </StackPanel>

                <!-- Lijst met zenders, films en series -->
                <Grid Grid.Row="1" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                    <ListBox x:Name="ChannelList" ItemsSource="{Binding Rows}"
                             MouseDoubleClick="ChannelList_MouseDoubleClick"
                             KeyDown="ChannelList_KeyDown"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Info}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Width="30" Height="30" Margin="0,0,8,0"
                                           Stretch="Uniform"
                                           Source="{Binding LogoUrl, Converter={StaticResource UrlToImage}, IsAsync=True}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding NowTitle}" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NowTitle}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding KindLabel}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource DimText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding KindLabel}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="✓ Bekeken" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding DownloadText}" FontSize="11" Foreground="{StaticResource AccentBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DownloadText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Niet meer bij je provider" FontSize="11" Foreground="#E5A04B"
                                                   Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↺" ToolTip="{Binding CatchupText}" Foreground="{StaticResource DimBrush}"
                                                   FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasCatchup, Converter={StaticResource BoolToVis}}"/>
                                        <Button ToolTip="Downloaden om later (ook zonder internet) te kijken"
                                                Command="{Binding DownloadCommand}" Padding="8,5" Margin="8,0,0,0"
                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="Downloaden">
                                            <Path Style="{StaticResource GlyphPath}" Data="{StaticResource IconDownload}"/>
                                        </Button>
                                        <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite}"
                                                      ToolTip="Favoriet" Margin="6,0,0,0"/>
                                        <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}"
                                                Margin="2,0,0,0"/>
                                    </StackPanel>

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Afspelen / openen" Command="{Binding PlayCommand}"/>
                                            <MenuItem Header="Downloaden" Command="{Binding DownloadCommand}"
                                                      Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="Reservezender instellen…" Command="{Binding SetBackupsCommand}"
                                                      Visibility="{Binding CanHaveBackups, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="Reservezenders verwijderen" Command="{Binding ClearBackupsCommand}"
                                                      Visibility="{Binding HasBackups, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="Naam wijzigen…" Command="{Binding RenameCommand}"/>
                                            <MenuItem Header="Officiële naam terugzetten" Command="{Binding ResetNameCommand}"
                                                      Visibility="{Binding IsRenamed, Converter={StaticResource BoolToVis}}"/>
                                            <Separator/>
                                            <MenuItem Header="Naar boven in lijst" Command="{Binding MoveToTopCommand}"/>
                                            <MenuItem Header="Een plek omhoog" Command="{Binding MoveUpCommand}"/>
                                            <MenuItem Header="Een plek omlaag" Command="{Binding MoveDownCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Uit mijn lijst verwijderen" Command="{Binding RemoveCommand}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="12,24"
                               VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text="Je lijst is nog leeg.&#10;Ga naar 'Beheer' om een bron toe te voegen en je zenders, films en series te kiezen."/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="12,24"
                               VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}"
                               Text="Niets gevonden met dit filter."/>
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="12,24"
                               VerticalAlignment="Top" HorizontalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding HasNoKindItems, Converter={StaticResource BoolToVis}}"
                               Text="{Binding KindEmptyText}"/>
                </Grid>

                <!-- Afleveringen van een geopende serie -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsSeriesOpen, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Content="← Terug" Command="{Binding CloseSeriesCommand}"
                                Padding="10,5" Margin="0,0,10,0"/>
                        <Button DockPanel.Dock="Right" Command="{Binding DownloadSeasonCommand}"
                                ToolTip="Alle afleveringen van dit seizoen downloaden" Padding="10,5" Margin="10,0,0,0"
                                Visibility="{Binding CanDownloadSeason, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource GlyphPath}" Data="{StaticResource IconDownload}"/>
                                <TextBlock Text="Seizoen" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding SeriesTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding SeriesInfo}" Style="{StaticResource DimText}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="58" FontSize="12" Margin="0,0,0,8"/>
                        <TextBlock Text="Afleveringen ophalen…" Style="{StaticResource DimText}" Margin="0,0,0,8"
                                   Visibility="{Binding IsLoadingSeries, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SeriesError}" Foreground="#E5A04B" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding HasSeriesError, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" Margin="0,0,0,6" ItemsSource="{Binding Seasons}"
                             SelectedItem="{Binding SelectedSeason, Mode=TwoWay}"
                             ItemsPanel="{StaticResource WrapItems}"
                             ItemContainerStyle="{StaticResource PillItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" Margin="4,0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="3" x:Name="EpisodeList" ItemsSource="{Binding Episodes}"
                             MouseDoubleClick="EpisodeList_MouseDoubleClick"
                             KeyDown="EpisodeList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Plot}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" ToolTip="Downloaden om later (ook zonder internet) te kijken"
                                                Command="{Binding DownloadCommand}" Padding="8,4" Margin="8,0,0,0"
                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.Name="Downloaden">
                                            <Path Style="{StaticResource GlyphPath}" Data="{StaticResource IconDownload}"/>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" Style="{StaticResource DimText}"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ResumeText}" FontSize="11" Foreground="{StaticResource AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResumeText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="✓ Bekeken" FontSize="11" Style="{StaticResource DimText}"
                                               Visibility="{Binding IsWatched, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DownloadText}" FontSize="11" Foreground="{StaticResource AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DownloadText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <TextBlock Grid.Row="2" Style="{StaticResource DimText}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                           Text="Dubbelklik om te kijken. Rechtsklik voor volgorde en verwijderen."/>
            </Grid>
        </Border>

        <!-- Speler -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Startscherm: wat je ziet zolang er niets speelt. De videospeler (een eigen Windows-venster) wordt dan verborgen,
                 anders staat er een zwart of wit vlak in beeld. -->
            <Grid Grid.Row="0" Visibility="{Binding ShowCover, Converter={StaticResource BoolToVis}}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#151515" Offset="0"/>
                        <GradientStop Color="#0D0F13" Offset="0.6"/>
                        <GradientStop Color="#171214" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <Image Source="{StaticResource LogoImage}" Width="96" Height="96" HorizontalAlignment="Center"/>
                    <TextBlock Text="EyePTV" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,6"/>

                    <!-- Nog niets gekozen -->
                    <StackPanel Visibility="{Binding ShowStartScreen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Kies links een zender, film of serie om te beginnen." Style="{StaticResource DimText}"
                                   TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" FontSize="14"/>
                        <TextBlock Text="Tip: bij een zender met ↺ kun je programma's terugkijken vanuit de gids onderin."
                                   Style="{StaticResource DimText}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center"
                                   FontSize="12" Margin="0,14,0,0" Opacity="0.7"/>
                    </StackPanel>

                    <!-- Er wordt gecast: het beeld staat op de tv -->
                    <TextBlock Text="{Binding CastCoverText}" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2"
                               Visibility="{Binding ShowCastCover, Converter={StaticResource BoolToVis}}"/>

                    <!-- Gekozen, de speler laadt nog (of er ging iets mis): de melding staat eronder -->
                    <StackPanel Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="3" Margin="0,2,0,12"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}"
                                   TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <vlc:VideoView x:Name="VideoView" Grid.Row="0" Background="Black">
                <vlc:VideoView.Style>
                    <Style TargetType="vlc:VideoView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowVideo}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </vlc:VideoView.Style>
            </vlc:VideoView>

            <!-- Bediening -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="16,12,16,6"
                    Visibility="{Binding ShowChrome, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Audiosporen en ondertitels: alleen bij films en afleveringen -->
                    <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowTrackRow, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                        Visibility="{Binding HasAudioChoice, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0">
                                <TextBlock Text="Audio" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox MinWidth="180" ItemsSource="{Binding AudioTracks}"
                                          SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                        Visibility="{Binding HasSubtitleChoice, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0">
                                <TextBlock Text="Ondertitels" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox MinWidth="180" ItemsSource="{Binding SubtitleTracks}"
                                          SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}" DisplayMemberPath="Name"/>
                            </StackPanel>
                            
                        </DockPanel>

                        
                    </StackPanel>

                    <!-- Opnemen: alleen bij live-tv -->
                    <DockPanel Margin="0,0,0,10" LastChildFill="False" Visibility="{Binding CanRecord, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Left" Style="{StaticResource RecordButton}" Padding="14,5" Click="RecordMenuButton_Click"
                                Visibility="{Binding ShowRecordButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="Opnemen: dit programma, een bepaalde tijd of tot je zelf stopt">
                            <TextBlock><Run Text="● Opnemen"/><Run Text="  ▾"/></TextBlock>
                        </Button>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                    Visibility="{Binding IsRecordingCurrent, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource RecordedButton}" Padding="14,5" Command="{Binding RecordCommand}" CommandParameter="stop"
                                    Content="■ Opname stoppen"/>
                            <TextBlock Text="{Binding RecordingText}" Foreground="#FF6B64" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="● Er staat een opname gepland voor deze zender" Foreground="#FF6B64" FontSize="12"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   Visibility="{Binding HasPlannedRecording, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>

                    <!-- Pauze en spoelen: alleen bij films, afleveringen en terugkijken -->
                    <DockPanel Margin="0,0,0,8" LastChildFill="True"
                               Visibility="{Binding ShowTransport, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                            <Button Content="−15 s" Command="{Binding SeekBackCommand}" ToolTip="15 seconden terug (←)"
                                    Padding="10,5" Margin="0,0,6,0" IsEnabled="{Binding CanSeek}"/>
                            <!-- Staat de video stil, dan zie je een afspeelknop; speelt hij, dan een pauzeknop -->
                            <Button Command="{Binding TogglePauseCommand}" Padding="14,5" Margin="0,0,6,0" MinWidth="44"
                                    ToolTip="Pauze / verder (spatiebalk)">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{StaticResource TextBrush}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource PauseIcon}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource PlayIcon}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Content="+15 s" Command="{Binding SeekForwardCommand}" ToolTip="15 seconden vooruit (→)"
                                    Padding="10,5" IsEnabled="{Binding CanSeek}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PositionText}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="110" TextAlignment="Right"/>
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                Value="{Binding PositionFraction, Mode=OneWay}"
                                IsEnabled="{Binding CanSeek}" IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"/>
                    </DockPanel>

                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CastButton" ToolTip="{Binding CastTooltip}" Click="Cast_Click" Margin="0,0,4,0"
                                    Visibility="{Binding ShowCastButton, Converter={StaticResource BoolToVis}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCasting}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M21,3H3C1.9,3,1,3.9,1,5v3h2V5h18v14h-7v2h7c1.1,0,2-0.9,2-2V5C23,3.9,22.1,3,21,3z M1,18v3h3C4,19.3,2.7,18,1,18z M1,14v2c2.8,0,5,2.2,5,5h2C8,17.1,4.9,14,1,14z M1,10v2c4.9,0,9,4.1,9,9h2C12,14.9,6.1,10,1,10z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="AlternativesButton" Style="{StaticResource SubtleButton}" Content="{Binding AlternativesText}"
                                    ToolTip="Dezelfde zender via een andere stream" Click="Alternatives_Click" Margin="0,0,10,0"
                                    Visibility="{Binding HasAlternatives, Converter={StaticResource BoolToVis}}"/>
                            <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding IsMuted}"
                                          ToolTip="Dempen" Margin="0,0,6,0"/>
                            <Slider Width="110" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Programma-informatie en gids -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="16,6,16,12" Height="210"
                    Visibility="{Binding ShowChrome, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="420"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <DockPanel Visibility="{Binding IsReplay, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Terug naar live" Command="{Binding BackToLiveCommand}"
                                    Style="{StaticResource AccentButton}" Padding="10,4"/>
                            <TextBlock Text="↺ TERUGKIJKEN" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding NowTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NowTime}" Style="{StaticResource DimText}" Margin="0,2,0,6"/>
                        <!-- Bij films, afleveringen en terugkijken is de spoelbalk hierboven de voortgang: geen tweede balk -->
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,0,0,8">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTransport}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Text="{Binding NowDescription}" TextWrapping="Wrap" MaxHeight="64"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource DimBrush}"/>
                        <TextBlock Text="{Binding NextText}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Dagen: bij zenders met terugkijken ook de afgelopen dagen -->
                        <TextBlock Grid.Row="0" Style="{StaticResource DimText}" FontSize="11" Margin="0,0,0,4"
                                   Text="Terugkijken is bij deze zender niet beschikbaar (de provider biedt geen archief)."
                                   Visibility="{Binding ShowNoCatchupHint, Converter={StaticResource BoolToVis}}"/>
                        <ListBox Grid.Row="0" Margin="0,0,0,4" ItemsSource="{Binding ScheduleDays}"
                                 SelectedItem="{Binding SelectedScheduleDay, Mode=TwoWay}"
                                 ItemsPanel="{StaticResource WrapItems}"
                                 ItemContainerStyle="{StaticResource PillItem}"
                                 Visibility="{Binding HasScheduleDays, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Margin="2,0"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Grid.Row="1" x:Name="ScheduleList" ItemsSource="{Binding Schedule}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Description}">
                                        <Button DockPanel.Dock="Right" Command="{Binding RecordCommand}" Margin="6,0,0,0" Padding="9,0"
                                                Visibility="{Binding CanRecord, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Opnemen (begint iets eerder, loopt iets langer door)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RecordButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecorded}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Background" Value="#C0392B"/>
                                                            <Setter Property="BorderBrush" Value="#C0392B"/>
                                                            <Setter Property="ToolTip" Value="Opname gepland: klik om te annuleren"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="●"/>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Command="{Binding ReplayCommand}"
                                                ToolTip="Dit programma vanaf het begin terugkijken" Padding="9,2" Margin="8,0,0,0"
                                                Foreground="{StaticResource AccentBrush}" FontSize="12"
                                                Visibility="{Binding CanReplay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource PlayIcon}" Fill="{StaticResource AccentBrush}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="Terugkijken"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock DockPanel.Dock="Left" Width="92" Text="{Binding TimeText}"
                                                   Style="{StaticResource DimText}"/>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNow}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReplaying}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bladerscherm van Films en Series (alleen zolang er niets speelt): planken per categorie, daarna alle titels van één categorie -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource AmbientBrush}" Panel.ZIndex="10" Style="{StaticResource FadeIn}"
              Visibility="{Binding ShowBrowse, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Laag 1: kop -->
            <DockPanel Grid.Row="0" Margin="36,22,36,6" Visibility="{Binding ShowBrowseGroups, Converter={StaticResource BoolToVis}}">
                <TextBox DockPanel.Dock="Right" Width="280" VerticalAlignment="Center" ToolTip="Zoek in je lijst (Enter toont de resultaten)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding OpenCategoryCommand}" CommandParameter="Alle groepen"/>
                    </TextBox.InputBindings>
                </TextBox>
                <CheckBox DockPanel.Dock="Right" Content="Nieuwste eerst" IsChecked="{Binding SortNewest}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="Meest recent toegevoegd bovenaan"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Alles tonen" Command="{Binding OpenCategoryCommand}"
                        CommandParameter="Alle groepen" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding BrowseTitle}" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="34" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Laag 1: een plank met posters per categorie (alleen de planken in beeld worden opgebouwd) -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Shelves}" Background="Transparent" BorderThickness="0" Padding="24,0,24,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling" KeyboardNavigation.TabNavigation="Continue"
                     Visibility="{Binding ShowBrowseGroups, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="12,18,0,4">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource DimText}" FontSize="12" Margin="12,3,0,0" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource PillButton}" Content="Alles  ›" Margin="14,0,0,0" Padding="12,4" FontSize="12"
                                        Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding Group}"/>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Shelf_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TitlePoster}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Style="{StaticResource DimText}" Text="Niets gevonden." HorizontalAlignment="Center" Margin="0,40,0,0"
                       VerticalAlignment="Top" Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVis}}"/>

            <!-- Laag 2: alle titels van de gekozen categorie -->
            <DockPanel Grid.Row="0" Margin="36,22,36,6" Visibility="{Binding ShowBrowseTitles, Converter={StaticResource BoolToVis}}">
                <TextBox DockPanel.Dock="Right" Width="280" VerticalAlignment="Center" ToolTip="Zoek in deze categorie"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <CheckBox DockPanel.Dock="Right" Content="Nieuwste eerst" IsChecked="{Binding SortNewest}" Margin="0,0,16,0" VerticalAlignment="Center"
                          ToolTip="Meest recent toegevoegd bovenaan"/>
                <Button DockPanel.Dock="Left" Style="{StaticResource PillButton}" Content="‹  Categorieën" Command="{Binding BrowseCommand}"
                        Margin="0,0,16,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding BrowseGroupTitle}" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="34" FontWeight="Bold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,8,30,26"
                          Visibility="{Binding ShowBrowseTitles, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding BrowseTitles}" ItemsPanel="{StaticResource WrapItems}" ItemTemplate="{StaticResource TitlePoster}"/>
                    <TextBlock Text="{Binding BrowseTruncatedText}" Style="{StaticResource DimText}" Margin="8,12,0,0"
                               Visibility="{Binding BrowseTitlesTruncated, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Niets gevonden." Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,40,0,0"
                               Visibility="{Binding HasNoBrowseTitles, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
