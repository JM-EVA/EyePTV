<UserControl x:Class="IptvPlayer.Desktop.Views.BeheerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IptvPlayer.Desktop.Views">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,6">
            <TextBlock Text="Beheer" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,12"
                       Text="Je bronnen, opnames, downloads en voorkeuren op één plek."/>
            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     ItemsPanel="{StaticResource WrapItems}" ItemContainerStyle="{StaticResource PillItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="8,1"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsBronnen, Converter={StaticResource BoolToVis}}">
                <views:SourcesView DataContext="{Binding Sources}"/>
            </Grid>
            <Grid Visibility="{Binding IsOpnames, Converter={StaticResource BoolToVis}}">
                <views:RecordingsView DataContext="{Binding Settings}"/>
            </Grid>
            <Grid Visibility="{Binding IsDownloads, Converter={StaticResource BoolToVis}}">
                <views:DownloadsView DataContext="{Binding Settings}"/>
            </Grid>
            <Grid Visibility="{Binding IsVoorkeuren, Converter={StaticResource BoolToVis}}">
                <views:PreferencesView DataContext="{Binding Settings}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
