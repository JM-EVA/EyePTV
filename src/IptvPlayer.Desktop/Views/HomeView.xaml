<UserControl x:Class="IptvPlayer.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:IptvPlayer.Desktop.Services">

    <UserControl.Resources>
        <svc:UrlToImageConverter x:Key="UrlToImage"/>
        <svc:PreviewImageConverter x:Key="PreviewImage"/>

        <!-- Menu bij een kaart: markeren als bekeken en verwijderen uit Verder kijken (rechtsklik of de knop met de puntjes) -->
        <ContextMenu x:Key="CardMenu" x:Shared="False">
            <MenuItem Header="Markeren als bekeken" Command="{Binding MarkWatchedCommand}"/>
            <MenuItem Header="Verwijderen uit Verder kijken" Command="{Binding RemoveCommand}"/>
        </ContextMenu>

        <!-- Ronde knop met puntjes rechtsboven op een kaart; verschijnt als je de kaart aanwijst -->
        <Style x:Key="CardMenuButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="#CC000000"/>
                            <Path Data="M9,12 L9.01,12 M12,12 L12.01,12 M15,12 L15.01,12" Stroke="White" StrokeThickness="2.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>



        <!-- Kaart: bij aanwijzen een zacht vlak en een lichte vergroting (Apple TV-gevoel) -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Glow" CornerRadius="16" Background="Transparent" BorderThickness="2" BorderBrush="Transparent" Padding="6">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Background" Value="#14FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glow" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Staande poster (films en series): titel over het beeld, zoals op een filmhoes -->
        <DataTemplate x:Key="PosterCard">
            <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" Margin="0,0,2,0" ToolTip="{Binding Title}"
                    ContextMenu="{StaticResource CardMenu}" ContextMenuService.IsEnabled="{Binding HasMenu}">
                <Grid Width="170" Height="255">
                    <!-- Het masker moet dekkend zijn: zijn doorzichtigheid bepaalt hoe zichtbaar de inhoud is -->
                    <Border x:Name="Mask" CornerRadius="14" Background="Black"/>
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=Mask}"/>
                        </Grid.OpacityMask>
                        <Rectangle Fill="{StaticResource PopupBrush}"/>
                        <!-- Zonder poster: een pictogram dat bij de soort past -->
                        <Path Width="44" Height="44" Stretch="Uniform" Stroke="{StaticResource DimBrush}" StrokeThickness="1.5" Opacity="0.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconMovies}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Badge}" Value="SERIE">
                                            <Setter Property="Data" Value="{StaticResource IconSeries}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Badge}" Value="OPNAME">
                                            <Setter Property="Data" Value="{StaticResource IconRecord}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}, ConverterParameter=320, IsAsync=True}">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Stretch" Value="UniformToFill"/>
                                    <Style.Triggers>
                                        <!-- Een opname heeft een zenderlogo, geen poster: niet bijsnijden -->
                                        <DataTrigger Binding="{Binding IsLandscape}" Value="True">
                                            <Setter Property="Stretch" Value="Uniform"/>
                                            <Setter Property="Margin" Value="30,30,30,90"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Border VerticalAlignment="Bottom" Padding="12,44,12,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#CC000000" Offset="0.55"/>
                                    <GradientStop Color="#F2000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontWeight="Bold" FontSize="17"
                                           TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="#B8B8B8" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <ProgressBar VerticalAlignment="Bottom" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource CardMenuButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Click="CardMenu_Click" ToolTip="Meer opties" AutomationProperties.Name="Meer opties"
                                Visibility="{Binding HasMenu, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}" IsHitTestVisible="False"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Liggende kaart (zenders en opnames) -->
        <DataTemplate x:Key="WideCard">
            <Button Style="{StaticResource CardButton}" Command="{Binding OpenCommand}" Margin="0,0,10,0"
                    MouseEnter="LiveCard_MouseEnter" MouseLeave="LiveCard_MouseLeave"
                    ContextMenu="{StaticResource CardMenu}" ContextMenuService.IsEnabled="{Binding HasMenu}">
                <StackPanel Width="250">
                    <Border Width="250" Height="140" Background="{StaticResource Panel2Brush}">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,250,140" RadiusX="12" RadiusY="12"/>
                        </Border.Clip>
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2A2A2A" Offset="0"/>
                                    <GradientStop Color="#1A1A1A" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <!-- Zonder beeld van de uitzending: het logo midden op de kaart -->
                            <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}, ConverterParameter=200, IsAsync=True}"
                                   Stretch="Uniform" Margin="56,26"
                                   Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVis}}"/>
                            <!-- Met beeld van de uitzending: dat vult de kaart, het logo staat klein in de hoek -->
                            <Image Source="{Binding PreviewPath, Converter={StaticResource PreviewImage}}" Stretch="UniformToFill"
                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}"/>
                            <!-- Live meekijken (zonder geluid) zolang je de kaart aanwijst -->
                            <Image x:Name="LiveFrame" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,8,8,12" Padding="5" CornerRadius="8"
                                    Background="#B0000000" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}, ConverterParameter=96, IsAsync=True}"
                                       Width="30" Height="30" Stretch="Uniform"/>
                            </Border>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2" CornerRadius="6" Background="#B0000000">
                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <ProgressBar VerticalAlignment="Bottom" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource CardMenuButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                    Click="CardMenu_Click" ToolTip="Meer opties" AutomationProperties.Name="Meer opties"
                                    Visibility="{Binding HasMenu, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource DimText}" FontSize="12" Margin="2,2,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Een plank met kaarten: kop en een rij die opzij scrolt -->
        <Style x:Key="ShelfTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,26,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,14,30,40">

            <!-- Bovenaan: het laatste dat je bekeek (groot) met de rest van "verder kijken" ernaast; anders een welkom -->
            <TextBlock Style="{StaticResource ShelfTitle}" Margin="6,10,0,6">
                <TextBlock.Text>
                    <Binding Path="Greeting"/>
                </TextBlock.Text>
            </TextBlock>
            <Grid Height="352">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="6">
                    <Border x:Name="HeroMask" CornerRadius="20" Background="Black"/>
                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=HeroMask}"/>
                        </Grid.OpacityMask>
                        <Rectangle Fill="{StaticResource GlassBrush}"/>

                        <!-- Achtergrond: de poster, groot en wazig, met een donker verloop voor de tekst -->
                        <Image Source="{Binding Hero.ImageUrl, Converter={StaticResource UrlToImage}, ConverterParameter=400, IsAsync=True}"
                               Stretch="UniformToFill" Opacity="0.55">
                            <Image.Effect>
                                <BlurEffect Radius="48" RenderingBias="Performance"/>
                            </Image.Effect>
                        </Image>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#990E0E10" Offset="0"/>
                                    <GradientStop Color="#590E0E10" Offset="0.5"/>
                                    <GradientStop Color="#1A0E0E10" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Met "verder kijken" -->
                        <Grid Margin="38,30" Visibility="{Binding HasHero, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold">
                                    <Run Text="VERDER KIJKEN  ·  "/><Run Text="{Binding Hero.Badge, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Hero.Title}" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="44" FontWeight="Bold"
                                           TextWrapping="Wrap" MaxHeight="112" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Hero.Subtitle}" Foreground="#C4C4C4" FontSize="14" Margin="0,6,0,14" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Height="4" Width="320" HorizontalAlignment="Left" Minimum="0" Maximum="1"
                                             Value="{Binding Hero.Progress, Mode=OneWay}" Margin="0,0,0,22"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="24,10" FontSize="14" Command="{Binding Hero.OpenCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                                <Canvas Width="24" Height="24"><Path Data="{StaticResource PlayIcon}" Fill="#111111"/></Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Hervatten"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="10,0,0,0" Padding="18,10" FontSize="14" Content="Meer opties" Background="#33000000" BorderBrush="#33FFFFFF"
                                            Tag="{Binding Hero}" Click="CardMenu_Click" ToolTip="Markeren als bekeken of verwijderen uit Verder kijken"
                                            Visibility="{Binding Hero.HasMenu, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" Width="187" Height="280" Margin="30,0,6,0" VerticalAlignment="Center">
                                <Border x:Name="HeroPosterMask" CornerRadius="14" Background="Black"/>
                                <Image Source="{Binding Hero.ImageUrl, Converter={StaticResource UrlToImage}, ConverterParameter=400, IsAsync=True}" Stretch="UniformToFill">
                                    <Image.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=HeroPosterMask}"/>
                                    </Image.OpacityMask>
                                </Image>
                            </Grid>
                        </Grid>

                        <!-- Zonder: een welkom -->
                        <Grid Margin="38,30" Visibility="{Binding HasHero, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Text="EYEPTV" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="Wat wil je kijken?" FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="44" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock Foreground="#C4C4C4" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,22"
                                           Text="Wat je half bekijkt, staat hier straks klaar om verder te kijken."/>
                                <TextBlock FontSize="13" TextWrapping="Wrap" Margin="0,-10,0,22"
                                           Foreground="#E5A04B" Visibility="{Binding IsEmptyLibrary, Converter={StaticResource BoolToVis}}"
                                           Text="Je lijst is nog leeg. Ga naar 'Beheer' om een bron toe te voegen en je zenders, films en series te kiezen."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Padding="24,10" FontSize="14" Command="{Binding LiveCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="14" Height="14" Margin="0,0,9,0">
                                                <Canvas Width="24" Height="24"><Path Data="{StaticResource PlayIcon}" Fill="#111111"/></Canvas>
                                            </Viewbox>
                                            <TextBlock Text="Kanalen"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="10,0,0,0" Padding="18,10" FontSize="14" Content="Tv-gids" Background="#33000000" BorderBrush="#33FFFFFF"
                                            Command="{Binding GuideCommand}"/>
                                </StackPanel>
                            </StackPanel>
                            <Image Grid.Column="1" Source="{StaticResource LogoImage}" Width="132" Height="132" Margin="30,0,40,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Border CornerRadius="20" BorderThickness="1" BorderBrush="{StaticResource GlassBorderBrush}" IsHitTestVisible="False"/>
                </Grid>

                <!-- De rest van "verder kijken": hoge posters naast het grote vlak -->
                <ScrollViewer Grid.Column="1" MaxWidth="720" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="Shelf_PreviewMouseWheel"
                              Visibility="{Binding HasContinue, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding ContinueItems}" ItemTemplate="{StaticResource PosterCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="LayoutTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.272" ScaleY="1.272"/></Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Films -->
            <StackPanel Visibility="{Binding HasMovies, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="6,26,0,6">
                    <TextBlock Text="Films" Style="{StaticResource ShelfTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PillButton}" Content="Alles  ›" Command="{Binding MoviesCommand}" Margin="14,0,0,0" Padding="12,4" FontSize="12"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Shelf_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding MovieItems}" ItemTemplate="{StaticResource PosterCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Series -->
            <StackPanel Visibility="{Binding HasSeries, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="6,26,0,6">
                    <TextBlock Text="Series" Style="{StaticResource ShelfTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PillButton}" Content="Alles  ›" Command="{Binding SeriesCommand}" Margin="14,0,0,0" Padding="12,4" FontSize="12"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Shelf_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding SeriesItems}" ItemTemplate="{StaticResource PosterCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Zenders -->
            <StackPanel Visibility="{Binding HasLive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LiveTitle}" Style="{StaticResource ShelfTitle}"/>
                <!-- Een raster onder elkaar (max. 20), scrollen doet de hele pagina -->
                <ItemsControl x:Name="LiveGrid" ItemsSource="{Binding LiveItems}" ItemTemplate="{StaticResource WideCard}" SizeChanged="LiveGrid_SizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Opnames -->
            <StackPanel Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Je opnames" Style="{StaticResource ShelfTitle}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Shelf_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding RecentRecordings}" ItemTemplate="{StaticResource WideCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
