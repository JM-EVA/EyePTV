<Window x:Class="IptvPlayer.Desktop.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/app.ico">

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource DimBrush}" LineHeight="20" Margin="0,0,0,14"/>
        <TextBox Grid.Row="1" x:Name="Input" Margin="0,0,0,20" MaxLength="120"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Opslaan" Style="{StaticResource AccentButton}" Padding="18,9" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Annuleren" Padding="18,9" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
